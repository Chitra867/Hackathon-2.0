# UpacharKhoj Frontend Environment Variables
# Copy this file to .env and fill in the values.

# Backend API base URL (Vite proxies /api → this in development)
VITE_API_BASE_URL=http://localhost:8000

# Map tiles are OpenStreetMap (no key required)
# Routing uses public OSRM (https://router.project-osrm.org) — no key required
# For production, consider hosting your own OSRM instance
